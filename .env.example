# Supabase (Project Settings → API). Leave all three unset to run in demo
# mode against the in-memory seed dataset — no Supabase account needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by the Telegram webhook to write with elevated
# privileges. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional: set this to the same value you pass as `secret_token` when
# registering the webhook (see README) to verify requests are really from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Public bot username without the @. Enables the "add to group" shortcut.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Public URL of this deployment, used in bot replies to link back to the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
